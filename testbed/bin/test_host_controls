#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
trap '"$SCRIPT_DIR/compose" --profile host-controls down --volumes --remove-orphans' EXIT
"$SCRIPT_DIR/compose" --profile host-controls up --detach --build system
for _ in $(seq 1 30); do
  if "$SCRIPT_DIR/compose" --profile host-controls exec -T system systemctl is-system-running --wait >/dev/null 2>&1; then break; fi
  sleep 1
done
"$SCRIPT_DIR/compose" --profile host-controls exec -T system /workspace/testbed/system/test_host_controls.sh
