#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
trap '"$SCRIPT_DIR/compose" --profile host-controls down --volumes --remove-orphans' EXIT
"$SCRIPT_DIR/compose" --profile host-controls up --detach --build system
ready=false
for _ in $(seq 1 30); do
  state="$("$SCRIPT_DIR/compose" --profile host-controls exec -T system systemctl is-system-running --wait 2>/dev/null || true)"
  if [[ "$state" == "running" || "$state" == "degraded" ]]; then
    ready=true
    break
  fi
  sleep 1
done
if [[ "$ready" != true ]]; then
  "$SCRIPT_DIR/compose" --profile host-controls logs system >&2
  echo "systemd target did not become ready" >&2
  exit 1
fi
"$SCRIPT_DIR/compose" --profile host-controls exec -T system /workspace/testbed/system/test_host_controls.sh
